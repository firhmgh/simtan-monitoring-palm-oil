APP_NAME="SIMTAN - PTPN IV Regional I"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://simtan.yourdomain.com

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_simtan
DB_USERNAME=simtan_user
DB_PASSWORD=your_strong_db_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@simtan.ptpn4.co.id"
MAIL_FROM_NAME="${APP_NAME}"

# Neural Engine AI Integration (Server-Side Only)
# API 1: Google Gemini (Multimodal & Fast Executive Analysis)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# API 2: Groq Cloud (High-Speed LLM Inference & Failsafe Backup)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_TOKENS=450
